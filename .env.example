# Copy this file to ".env" and fill in your own values.
# .env is already gitignored, so it will never be committed.

# Required: Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model.
# Available options include: gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash
